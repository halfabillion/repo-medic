# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# --- Repo Medic safety switches (all off by default) ---
# Directories local repositories may be added from (colon-separated).
# REPO_MEDIC_LOCAL_ROOTS=/path/to/your/checkouts
# Run the tests of repositories cloned from GitHub during test-fix (executes their code).
# REPO_MEDIC_RUN_UNTRUSTED_TESTS=1
# Let open-pull-request push repo-medic/* branches and open PRs (uses the `gh` CLI login)...
# REPO_MEDIC_ALLOW_PUSH=1
# ...but only for these GitHub owners (comma-separated).
# REPO_MEDIC_PR_OWNERS=your-github-user
# Only for sandboxes whose DNS maps public hosts to private IPs: trust Builder's OAuth origins.
# AGENT_NATIVE_MCP_OAUTH_PRIVATE_ORIGINS=https://api.builder.io,https://mcp.builder.io
